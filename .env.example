# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in local values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://assessment:assessment@localhost:5432/assessment?schema=public"

# Secret used to sign the mock session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-random-32-byte-hex-string"

# Display/formatting defaults
APP_TIMEZONE="UTC"
CURRENCY="USD"
